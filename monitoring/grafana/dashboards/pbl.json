{
    "title":  "PBL Backend - Uptime, Latency, Errors",
    "uid":  "pbl-backend",
    "schemaVersion":  39,
    "version":  1,
    "refresh":  "5s",
    "time":  {
                 "from":  "now-15m",
                 "to":  "now"
             },
    "panels":  [
                   {
                       "id":  1,
                       "title":  "Uptime (seconds)",
                       "type":  "stat",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prom"
                                      },
                       "gridPos":  {
                                       "x":  0,
                                       "y":  0,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "s"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "expr":  "time() - process_start_time_seconds{job=\"pbl-backend\"}",
                                           "refId":  "A",
                                           "datasource":  {
                                                              "type":  "prometheus",
                                                              "uid":  "prom"
                                                          }
                                       }
                                   ]
                   },
                   {
                       "id":  2,
                       "title":  "Request rate (req/s)",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prom"
                                      },
                       "gridPos":  {
                                       "x":  12,
                                       "y":  0,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "reqps"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "expr":  "sum(rate(http_requests_total[1m]))",
                                           "refId":  "A",
                                           "datasource":  {
                                                              "type":  "prometheus",
                                                              "uid":  "prom"
                                                          }
                                       }
                                   ]
                   },
                   {
                       "id":  3,
                       "title":  "Latency p95",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prom"
                                      },
                       "gridPos":  {
                                       "x":  0,
                                       "y":  8,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "s"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "expr":  "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))",
                                           "refId":  "A",
                                           "datasource":  {
                                                              "type":  "prometheus",
                                                              "uid":  "prom"
                                                          }
                                       }
                                   ]
                   },
                   {
                       "id":  4,
                       "title":  "Error rate (5xx %)",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prom"
                                      },
                       "gridPos":  {
                                       "x":  12,
                                       "y":  8,
                                       "w":  12,
                                       "h":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "expr":  "100 * (sum(rate(http_requests_total{status_code=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_requests_total[1m]))",
                                           "refId":  "A",
                                           "datasource":  {
                                                              "type":  "prometheus",
                                                              "uid":  "prom"
                                                          }
                                       }
                                   ]
                   }
               ]
}
